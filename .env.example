# Copy to .env and fill in. Only EXPO_PUBLIC_* variables reach the app, and Expo
# inlines them at BUILD time: after any change, restart with `npx expo start --clear`.
# EAS builds don't see this file; set the same values with `eas env:create`.
# Everything here ships inside the app bundle, so never put secrets here.

# ---- Backend ----
# Base URL of bombay-canvas-be, without /api. Android emulator: http://10.0.2.2:5050
EXPO_PUBLIC_BASE_URL=http://10.0.2.2:5050

# ---- Google Sign-In ----
EXPO_PUBLIC_IOS_CLIENT_ID=
EXPO_PUBLIC_WEB_CLIENT_ID=

# ---- PostHog ----
# The API key is the master switch: leave it empty to turn PostHog off. Each
# feature below is on when unset; set "false" to turn one off.
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_API_HOST=
EXPO_PUBLIC_POSTHOG_EVENTS_ENABLED=
EXPO_PUBLIC_POSTHOG_LOGS_ENABLED=
EXPO_PUBLIC_POSTHOG_SESSION_REPLAY_ENABLED=
EXPO_PUBLIC_POSTHOG_ERRORS_ENABLED=

# ---- App Store ----
# The app's numeric App Store id (App Store Connect -> App Information -> Apple
# ID), for the "Update Canvas" prompt's link on iOS. Without it the prompt opens
# the App Store search instead.
EXPO_PUBLIC_APPLE_APP_STORE_ID=

# ---- Regional pricing (debug builds only) ----
# Pretend the Play Store account is in this country (ISO code, e.g. US, IN, AU)
# to test regional prices without a matching account. Ignored in release builds.
EXPO_PUBLIC_DEV_STORE_COUNTRY=
