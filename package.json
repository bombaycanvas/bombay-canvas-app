    "@types/react-test-renderer": "^19.1.0",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "patch-package": "^8.0.1",
    "prettier": "2.8.8",
    "react-test-renderer": "19.1.0",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "expo": {
    "install": {
      "exclude": [
        "@react-native-community/slider",
        "@types/react",
        "react-native",
        "react-native-gesture-handler",
