    "react-native-tracking-transparency": "^0.1.2",
    "react-native-vector-icons": "^10.3.0",
    "react-native-video": "^6.16.1",
    "react-native-worklets": "^0.7.4",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
