{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development",
      "android": {
        "withoutCredentials": true
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview",
      "android": {
        "buildType": "apk",
        "withoutCredentials": true
      },
      "env": {
        "ORG_GRADLE_PROJECT_MYAPP_UPLOAD_STORE_FILE": "debug.keystore",
        "ORG_GRADLE_PROJECT_MYAPP_UPLOAD_STORE_PASSWORD": "android",
        "ORG_GRADLE_PROJECT_MYAPP_UPLOAD_KEY_ALIAS": "androiddebugkey",
        "ORG_GRADLE_PROJECT_MYAPP_UPLOAD_KEY_PASSWORD": "android"
      }
    },
    "production": {
      "channel": "production",
      "environment": "production",
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      }
    }
  }
}
